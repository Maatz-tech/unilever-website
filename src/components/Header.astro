---
import Button from './Button.astro';
import { NAV_LINKS, INSCRICAO_URL } from '../data/site';
---

<header id="topo" class="cabecalho">
  <div class="container-lp flex h-[64px] items-center justify-between px-6 lg:h-[94px] lg:px-3">
    <a href="/" class="shrink-0 transition-opacity hover:opacity-80" aria-label="Unilever — página inicial">
      <img
        src={`${import.meta.env.BASE_URL}images/brand/unilever.webp`}
        alt="Unilever"
        width="165"
        height="36"
        class="h-[26px] w-auto lg:h-9"
        fetchpriority="high"
      />
    </a>

    <!-- No Figma o mobile não tem navegação: só logo + CTA. Sem hamburger. -->
    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-4 text-base text-night">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="link-nav">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={INSCRICAO_URL} size="sm" class="btn-compacto shrink-0">Inscreva-se</Button>
  </div>
</header>

<style>
  /* Sublinhado que cresce da esquerda, como no projeto React */
  /* Sticky com vidro, como no projeto React: fundo translúcido + blur e uma
     borda inferior sutil que separa do hero ao rolar. */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #e4e4e7;
    background: rgb(245 246 249 / 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (min-width: 1024px) {
    .cabecalho {
      border-bottom-color: rgb(19 48 98 / 0.08);
      background: rgb(255 255 255 / 0.85);
    }
  }

  .link-nav {
    position: relative;
    white-space: nowrap;
    padding-block: 4px;
    transition: color 300ms ease;
  }
  .link-nav::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 0;
    border-radius: 999px;
    background: var(--color-sky);
    transition: width 300ms ease;
  }
  .link-nav:hover {
    color: var(--color-sky);
  }
  .link-nav:hover::after {
    width: 100%;
  }
</style>

<script>
  import { prefersReducedMotion } from '../lib/motion';

  // entrada do header: desce 24px com fade (0.5s easeOut), igual ao legado
  const cabecalho = document.querySelector<HTMLElement>('#topo');
  if (cabecalho && !prefersReducedMotion()) {
    const { animate } = await import('motion');
    animate(cabecalho, { opacity: [0, 1], y: [-24, 0] }, { duration: 0.5, ease: [0, 0, 0.58, 1] });
  }
</script>
