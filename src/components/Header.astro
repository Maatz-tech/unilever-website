---
import Button from './Button.astro';
import { NAV_LINKS, INSCRICAO_URL } from '../data/site';
---

<header class="bg-cloud">
  <div class="container-lp flex h-[94px] items-center justify-between px-6 lg:px-3">
    <a href="/" class="shrink-0" aria-label="Unilever — página inicial">
      <img
        src={`${import.meta.env.BASE_URL}images/brand/unilever.webp`}
        alt="Unilever"
        width="165"
        height="36"
        class="h-9 w-auto"
        fetchpriority="high"
      />
    </a>

    <!-- No Figma o mobile não tem navegação: só logo + CTA. Sem hamburger. -->
    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-4 text-base text-night">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="whitespace-nowrap transition-colors hover:text-sky">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={INSCRICAO_URL} size="sm" class="shrink-0">Inscreva-se</Button>
  </div>
</header>
