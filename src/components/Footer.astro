---
import Instagram from './icons/Instagram.astro';
import Facebook from './icons/Facebook.astro';
import LinkedIn from './icons/LinkedIn.astro';
import TikTok from './icons/TikTok.astro';
import YouTube from './icons/YouTube.astro';
import X from './icons/X.astro';
import { SOCIAL_LINKS, LEGAL_LINKS, MAATZ_URL } from '../data/site';

// O mapa tem mais ícones do que SOCIAL_LINKS usa de propósito: o TikTok fica
// pronto para o dia em que o endereço aparecer.
const ICONS = { Instagram, Facebook, LinkedIn, TikTok, YouTube, X };
---

<footer class="bg-cloud">
  <!-- Bloco 1: logos + redes sociais -->
  <div
    class="container-lp flex flex-col items-center gap-10 px-6 py-10 md:flex-row md:items-start md:justify-between md:py-14 lg:px-3"
  >
    <!-- Altura fixa: no Figma o bloco de logos define a altura da faixa
         (49px no mobile, 56px no desktop), não o logo em si. -->
    <div class="flex h-[49px] items-center gap-[21px] md:h-14 md:gap-6">
      <img
        src={`${import.meta.env.BASE_URL}images/brand/unilever.webp`}
        alt="Unilever"
        width="168"
        height="36"
        class="h-[31.66px] w-auto md:h-9"
        loading="lazy"
      />
      <span class="h-[37.68px] w-px bg-[#4a4b53]/10 md:h-[43px]" aria-hidden="true"></span>
      <img
        src={`${import.meta.env.BASE_URL}images/brand/eureca.webp`}
        alt="Eureca"
        width="164"
        height="30"
        class="h-[26px] w-auto md:h-[30px]"
        loading="lazy"
      />
    </div>

    <!-- flex-wrap: são 6 ícones de 40px = 240px, que ainda cabem num viewport de
         320px, mas sem folga nenhuma. O wrap é a rede de segurança para o dia
         em que entrar a sétima rede. -->
    <ul class="flex flex-wrap items-center justify-center">
      {
        SOCIAL_LINKS.map((social) => {
          const Icon = ICONS[social.icon];
          return (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                title={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="flex size-10 items-center justify-center rounded-full text-sky-dark transition-colors hover:text-sky"
              >
                <Icon class="size-6" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Bloco 2: legal + créditos -->
  <div
    class="container-lp flex flex-col items-center gap-5 p-6 text-center md:flex-row md:justify-between md:gap-4 lg:px-3"
  >
    <!-- leading apertado: são labels de UI, não body copy (Figma usa leading-normal) -->
    <ul class="flex items-center gap-4 leading-[1.2]">
      {
        LEGAL_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="body-sm leading-[1.2] underline transition-colors hover:text-sky"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- O crédito inteiro é clicável, não só o logo: o alvo fica maior e o
         hover acende texto e marca juntos, como uma peça só. Sem aria-label —
         o texto do <span> + o alt da imagem já nomeiam o link. -->
    <a
      href={MAATZ_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 transition-opacity hover:opacity-80"
    >
      <span class="body-sm">Desenvolvido por</span>
      <img
        src={`${import.meta.env.BASE_URL}images/brand/maatz.svg`}
        alt="Maatz"
        width="72"
        height="18"
        class="h-[18px] w-auto"
        loading="lazy"
      />
    </a>
  </div>
</footer>
