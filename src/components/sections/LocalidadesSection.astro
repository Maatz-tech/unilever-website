---
import { VIEWBOX, ufPaths } from '../../data/brasilPaths.js';
import { localidades } from '../../data/localidades.js';

/**
 * Localidades — mapa do Brasil interativo.
 *
 * Figma: 4188:12169 (desktop, 1043.31) · 4204:19006 (mobile, 1275.09)
 *
 * O Figma exporta o mapa como 27 SVGs separados posicionados por `inset`.
 * Aqui usamos um único SVG com um <path> por estado (viewBox 613×639, mesma
 * proporção do frame do Figma): é o que permite clicar, focar por teclado e
 * pintar o estado selecionado sem gerenciar 27 imagens.
 *
 * Os pinos pulsantes vêm de `localidades` (campo `pino`), não de uma lista
 * própria: antes eram nove coordenadas soltas e sobrariam pinos em estados fora
 * do programa quando a lista encolhesse.
 *
 * "Confira as áreas" abre um modal com as áreas de cada cidade do estado
 * selecionado. Os três blocos são renderizados no HTML e o JS só alterna qual
 * está visível — sem `innerHTML`, e o conteúdo existe mesmo sem JS.
 */

const noPrograma = new Set(localidades.map((l) => l.uf));
const inicial = localidades[0];
const PLACE = `${import.meta.env.BASE_URL}images/map/place.svg`;

/**
 * O mapa são duas camadas empilhadas no mesmo viewBox, então elas se alinham
 * sozinhas em qualquer largura:
 *
 * 1. <img> com os 24 estados fora do programa. São 54 KB de desenho puro que
 *    não precisam estar no HTML — o arquivo é gerado no build por
 *    src/pages/images/map/brasil-base.svg.ts, a partir destes mesmos dados.
 * 2. <svg> inline só com SP, MG e PE mais os pinos: é o que responde a clique,
 *    foco e teclado, e o que muda de cor. Precisa do CSS e dos eventos da
 *    página, então continua inline.
 *
 * O aspect-ratio sai do viewBox e segura o espaço antes de a imagem chegar,
 * para o mapa não empurrar a página quando carregar.
 */
const MAPA_BASE = `${import.meta.env.BASE_URL}images/map/brasil-base.svg`;
const [, , MAPA_W, MAPA_H] = VIEWBOX.split(' ').map(Number);
---

<section id="localidades" class="bg-cloud py-[72px] lg:py-[120px]">
  <div class="container-lp flex flex-col gap-8 px-6 lg:px-3">
    <header class="flex flex-col items-center gap-2 text-center" data-reveal>
      <h2 class="text-[32px] font-bold leading-[1.2] text-sky lg:text-[48px]">Onde o game ganha vida</h2>
      <p class="text-[16px] leading-[1.5] text-night-72 lg:text-[24px]">
        Confira as localidades e as áreas de cada região
      </p>
    </header>

    <div class="grid gap-8 pt-6 lg:grid-cols-[minmax(0,592.2fr)_minmax(0,535.8fr)] lg:gap-16 lg:pt-[52px]">
      <!-- ── mapa: camada de fundo + estados clicáveis (ver frontmatter) ── -->
      <div class="relative self-center" style={`aspect-ratio:${MAPA_W}/${MAPA_H}`} data-reveal>
        <img
          src={MAPA_BASE}
          alt=""
          width={MAPA_W}
          height={MAPA_H}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full"
        />
        <svg
          viewBox={VIEWBOX}
          class="absolute inset-0 h-full w-full"
          role="group"
          aria-label="Mapa do Brasil com os estados do programa"
        >
          {
            ufPaths
              .filter((p: { uf: string }) => noPrograma.has(p.uf))
              .map((p: { uf: string; nome: string; d: string }) => (
                <path
                  d={p.d}
                  data-uf={p.uf}
                  role="button"
                  tabindex="0"
                  aria-label={`${p.nome}, ver localidades`}
                  aria-pressed={p.uf === inicial.uf ? 'true' : 'false'}
                  class="uf-ativo"
                  stroke="#fff"
                  stroke-width="1"
                />
              ))
          }
          {
            localidades.map((l: { pino: { cx: number; cy: number } }, i: number) => (
              <g class="pointer-events-none">
                <circle cx={l.pino.cx} cy={l.pino.cy} r="5" class="pino-pulso" style={`animation-delay:${i * 0.28}s`} />
                <circle cx={l.pino.cx} cy={l.pino.cy} r="4.5" fill="#fff" stroke="var(--color-sky)" stroke-width="2" />
              </g>
            ))
          }
        </svg>
      </div>

      <!-- ── card ─────────────────────────────────────────────────────── -->
      <div
        class="self-center rounded-3xl border border-night/10 bg-cloud px-6 pb-[37px] pt-[41px] shadow-[8px_7px_6px_rgb(0_0_0/0.02),34px_28px_11px_rgb(0_0_0/0.02)] lg:px-[41px]"
        data-reveal
      >
        <p class="rotulo">Estado selecionado</p>
        <div data-uf-bloco>
          <h3 data-uf-nome class="pt-[10px] text-[24px] font-bold leading-[1.5] text-night lg:text-[32px]">
            {inicial.nome}
          </h3>

          <ul data-uf-cidades class="flex flex-wrap gap-x-6 gap-y-1 pt-3">
            {
              inicial.cidades.map((cidade: { nome: string }) => (
                <li class="flex items-center gap-1">
                  <img src={PLACE} alt="" width="14" height="14" class="size-[13.993px]" />
                  <span class="text-[16px] leading-6 text-night-72">{cidade.nome}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <button type="button" data-abrir-areas class="link-areas mt-6 inline-flex items-center gap-2 text-[20px] font-bold text-sky">
          Confira as áreas
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="seta-areas size-5" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="mt-6 h-px w-full bg-night/12"></div>

        <p class="rotulo pt-6">Todos os estados do programa</p>

        <ul class="flex flex-wrap gap-2 pt-4">
          {
            localidades.map((l: { uf: string; nome: string }) => (
              <li>
                <button
                  type="button"
                  data-chip={l.uf}
                  aria-pressed={l.uf === inicial.uf ? 'true' : 'false'}
                  class="chip"
                >
                  {l.nome}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ── modal das áreas ──────────────────────────────────────────────────── -->
<dialog id="areas-dialog" class="areas-dialog" aria-labelledby="areas-titulo">
  <div data-areas-painel class="areas-painel">
   <div data-areas-corpo class="areas-corpo">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="rotulo">Áreas de atuação</p>
        <h3 id="areas-titulo" data-areas-uf class="pt-1 text-[24px] font-bold leading-[1.3] text-night lg:text-[32px]">
          {inicial.nome}
        </h3>
      </div>

      <button type="button" data-fechar-areas class="areas-fechar" aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    {
      localidades.map((l: { uf: string; cidades: { nome: string; areas: string[] }[] }, i: number) => (
        <div data-areas-estado={l.uf} hidden={i > 0} class="flex flex-col gap-6 pt-7">
          {l.cidades.map((cidade) => (
            <div>
              <p class="flex items-center gap-1.5">
                <img src={PLACE} alt="" width="14" height="14" class="size-[13.993px]" />
                <span class="text-[16px] font-bold leading-6 text-night">
                  {cidade.nome}/{l.uf.toUpperCase()}
                </span>
              </p>
              <ul class="flex flex-wrap gap-2 pt-3">
                {cidade.areas.map((area) => (
                  <li class="badge-area">{area}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))
    }
   </div>
  </div>
</dialog>

<style>
  .rotulo {
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 1.9px;
    text-transform: uppercase;
    color: rgb(19 48 98 / 0.45);
  }

  /* estados do programa: clicáveis */
  .uf-ativo {
    /* estados do programa: sky-pale no Figma, não sky-mid */
    fill: var(--color-sky-pale);
    cursor: pointer;
    transition: fill 300ms ease;
    outline: none;
  }
  .uf-ativo[aria-pressed='true'] {
    fill: var(--color-sky);
  }
  .uf-ativo:focus-visible {
    stroke: var(--color-aqua);
    stroke-width: 2;
  }

  /* pino pulsante — mesmo keyframe do projeto React */
  .pino-pulso {
    fill: var(--color-aqua);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulso 2.4s ease-out infinite;
  }

  @keyframes pulso {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 37.344px;
    padding: 8.556px 16.556px;
    border-radius: 999px;
    border: 0.556px solid rgb(19 48 98 / 0.12);
    background: var(--color-cloud);
    color: var(--color-night);
    font-size: 14px;
    line-height: 20.25px;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }
  /* group-hover:translate-x-1 e hover:text-sky do LocationsMap.jsx */
  .link-areas {
    transition: color 300ms ease;
  }
  .link-areas:hover {
    color: var(--color-sky-dark);
  }
  .seta-areas {
    transition: transform 300ms ease;
  }
  .link-areas:hover .seta-areas {
    transform: translateX(4px);
  }

  /* whileTap={{scale:0.95}} */
  .chip:active {
    transform: scale(0.95);
  }

  .chip:hover:not([aria-pressed='true']) {
    border-color: var(--color-sky);
    background: var(--color-sky-pale);
    color: var(--color-sky-dark);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-sky);
    border-color: var(--color-sky);
    color: var(--color-cloud);
  }

  /* --- modal das áreas ------------------------------------------------
     Mesmo overlay do visualizador de stories (rgb(5 16 40 / 0.88) com blur
     11.1px, Figma 4193:15160) para os dois modais do site serem a mesma
     coisa. O <dialog> nativo já entrega foco preso, ESC e backdrop. */
  /* O <dialog> ocupa a viewport inteira e centra o painel — sobrescrever
     max-width/max-height sem isso derruba o `margin:auto` do navegador e o
     painel gruda no canto. O `display` só vale com [open], senão o modal
     apareceria fechado. */
  .areas-dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .areas-dialog[open] {
    display: grid;
    place-items: center;
  }

  .areas-dialog::backdrop {
    background: rgb(5 16 40 / 0.88);
    backdrop-filter: blur(11.1px);
    -webkit-backdrop-filter: blur(11.1px);
  }

  /* O painel só desenha: raio, fundo, sombra. Quem rola é um filho que ocupa
     100% dele e carrega TODO o padding.
       - a barra encosta na borda direita do painel, como deve;
       - o `overflow: hidden` do pai recorta a barra no raio de 28px, então ela
         não cruza a curva do canto (era o que parecia estar do lado de fora);
       - com o padding no filho, o conteúdo rola de borda a borda: não sobra
         faixa morta em cima nem embaixo. */
  .areas-painel {
    width: min(560px, 92vw);
    max-height: min(84dvh, 760px);
    display: flex;
    border-radius: 28px;
    background: var(--color-cloud);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }

  .areas-corpo {
    width: 100%;
    /* min-height 0 é o que deixa o filho de um flex encolher e rolar */
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 28px 24px 32px;

    /* espaço da barra reservado sempre: só São Paulo tem conteúdo maior que o
       painel, e sem isso o texto pularia ao trocar de estado */
    scrollbar-gutter: stable;
  }

  /* Nada de `scrollbar-width`/`scrollbar-color`: ao ver qualquer uma das duas,
     o Chrome desenha a barra padrão dele e IGNORA o bloco abaixo — perderíamos
     o polegar arredondado em sky-pale. */
  .areas-corpo::-webkit-scrollbar {
    width: 8px;
  }
  /* Sem margem no trilho: a barra corre a altura inteira, colada na borda. Quem
     cuida do canto é o `overflow: hidden` do painel, que a recorta no raio. */
  .areas-corpo::-webkit-scrollbar-track {
    background: transparent;
  }
  .areas-corpo::-webkit-scrollbar-thumb {
    background: var(--color-sky-pale);
    border-radius: 999px;
  }
  .areas-corpo::-webkit-scrollbar-thumb:hover {
    background: var(--color-sky-mid);
  }

  /* Firefox não implementa ::-webkit-scrollbar; para ele, as padrão. */
  @supports not selector(::-webkit-scrollbar) {
    .areas-corpo {
      scrollbar-width: thin;
      scrollbar-color: var(--color-sky-pale) transparent;
    }
  }

  @media (min-width: 1024px) {
    .areas-corpo {
      padding: 36px 40px 40px;
    }
  }

  .areas-fechar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgb(19 48 98 / 0.06);
    color: var(--color-night);
    transition: background 180ms ease;
  }
  .areas-fechar:hover {
    background: rgb(19 48 98 / 0.12);
  }

  /* a tag de cada área */
  .badge-area {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--color-sky-pale);
    color: var(--color-sky-dark);
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pino-pulso {
      animation: none;
      opacity: 0.5;
    }
  }
</style>

<script>
  import { localidades } from '../../data/localidades.js';
  import { revealOnScroll, prefersReducedMotion } from '../../lib/motion';

  revealOnScroll('#localidades [data-reveal]');

  const secao = document.querySelector('#localidades');
  const dialog = document.querySelector<HTMLDialogElement>('#areas-dialog');

  if (secao && dialog) {
    const nome = secao.querySelector<HTMLElement>('[data-uf-nome]')!;
    const cidades = secao.querySelector<HTMLElement>('[data-uf-cidades]')!;
    const paths = Array.from(secao.querySelectorAll<SVGPathElement>('[data-uf]'));
    const chips = Array.from(secao.querySelectorAll<HTMLButtonElement>('[data-chip]'));
    const bloco = secao.querySelector<HTMLElement>('[data-uf-bloco]');

    const painel = dialog.querySelector<HTMLElement>('[data-areas-painel]')!;
    const corpo = dialog.querySelector<HTMLElement>('[data-areas-corpo]')!;
    const tituloModal = dialog.querySelector<HTMLElement>('[data-areas-uf]')!;
    const blocosModal = Array.from(dialog.querySelectorAll<HTMLElement>('[data-areas-estado]'));

    const PLACE = `${import.meta.env.BASE_URL}images/map/place.svg`;

    const selecionar = (uf: string) => {
      const l = localidades.find((x: { uf: string }) => x.uf === uf);
      if (!l) return;

      nome.textContent = l.nome;
      cidades.innerHTML = l.cidades
        .map(
          (c: { nome: string }) =>
            `<li class="flex items-center gap-1"><img src="${PLACE}" alt="" width="14" height="14" class="size-[13.993px]" /><span class="text-[16px] leading-6 text-night-72">${c.nome}</span></li>`
        )
        .join('');

      for (const p of paths) p.setAttribute('aria-pressed', String(p.dataset.uf === uf));
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.chip === uf));

      // o modal acompanha a seleção mesmo fechado
      tituloModal.textContent = l.nome;
      for (const b of blocosModal) b.hidden = b.dataset.areasEstado !== uf;

      // LocationsMap.jsx: o bloco do estado entra com y 12 e blur 6px (0.3s)
      if (bloco && !prefersReducedMotion()) {
        import('motion').then(({ animate }) =>
          animate(
            bloco,
            { opacity: [0, 1], y: [12, 0], filter: ['blur(6px)', 'blur(0px)'] },
            { duration: 0.3, ease: [0, 0, 0.58, 1] }
          )
        );
      }
    };

    for (const p of paths) {
      // o hover já seleciona de fato (atualiza o card e os chips), não só pinta
      p.addEventListener('mouseenter', () => selecionar(p.dataset.uf!));
      p.addEventListener('click', () => selecionar(p.dataset.uf!));
      p.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selecionar(p.dataset.uf!);
        }
      });
    }
    for (const c of chips) c.addEventListener('click', () => selecionar(c.dataset.chip!));

    // ── modal ──────────────────────────────────────────────────────────
    secao.querySelector('[data-abrir-areas]')?.addEventListener('click', async () => {
      dialog.showModal();
      corpo.scrollTop = 0;
      if (prefersReducedMotion()) return;
      const { animate } = await import('motion');
      // mesma entrada do card de stories, para os dois modais combinarem
      animate(painel, { opacity: [0, 1], scale: [0.92, 1], y: [24, 0] }, { type: 'spring', stiffness: 300, damping: 28 });
    });

    dialog.querySelector('[data-fechar-areas]')?.addEventListener('click', () => dialog.close());
    // clique fora do painel fecha
    dialog.addEventListener('click', (e) => {
      if (!painel.contains(e.target as Node)) dialog.close();
    });
  }
</script>
