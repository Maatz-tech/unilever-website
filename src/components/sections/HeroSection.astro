---
import HeroFrame from '../icons/HeroFrame.astro';
import HeroShape from '../icons/HeroShape.astro';
import { inscricaoUrl } from '../../data/site';

/**
 * Hero — 5 slides, desktop e mobile.
 *
 * Descoberta na coleta: os 5 slides do Figma têm EXATAMENTE o mesmo conteúdo
 * em primeiro plano (shape azul, lockup, CTA, "BORA ELEVAR O GAME?" e badge).
 * Só a foto muda. Então isto não é um carrossel de conteúdo: é um crossfade de
 * camada de imagem. Nada de ilha React — vanilla `motion`, zero hidratação.
 *
 * ESCALA — os dois palcos usam medidas em `em` e um `font-size` que define
 * quanto vale 1px do Figma:
 *   desktop: min(1px, (100vw - 48px) / 1392)  → trava em 1:1 a partir de 1440px
 *   mobile:  100vw / 390                      → sempre full-bleed
 *
 * PERFORMANCE: todas as imagens dos slides são `loading="lazy"`, inclusive o
 * slide 0. Quem prioriza o fundo correto é o `<link rel="preload" media>` do
 * Base.astro — assim o palco escondido por `display:none` não baixa nada.
 *
 * ARMADILHA: nunca colocar `font-size` e `padding` em `em` no MESMO elemento.
 * `em` de padding resolve contra o font-size do próprio elemento, então o texto
 * vai sempre num <span> interno. (Isso já quebrou o CTA uma vez.)
 */

/**
 * Geometria dos slides, medida no Figma — desktop e mobile são independentes.
 *
 * Tentei derivar o mobile do desktop por um fator de escala e não funcionou:
 * cada slide mobile tem seu próprio asset de fundo e recorte, e a pessoa fica
 * sempre em top 253.68 (não escalonado). Os valores abaixo vêm dos nós mobile.
 *
 * `blur` só existe no desktop — no mobile o desfoque já vem embutido no asset.
 */
const SLIDES = [
  {
    d: { bg: 'bg-1', pes: 'pes-1', left: 430.48, top: 77.76, w: 584.5, h: 562.5, blur: false },
    m: { bg: 'bg-1-m', pes: 'pes-1-m', h: 512.635 },
    dim: 0,
  },
  {
    d: { bg: 'bg-2', pes: 'pes-2', left: 355.65, top: 59.45, w: 639.5, h: 581, blur: true },
    m: { bg: 'bg-2-m', pes: 'pes-2-m', h: 419 },
    dim: 0,
  },
  {
    d: { bg: 'bg-3', pes: 'pes-3', left: 429.03, top: 63.98, w: 584.5, h: 576.5, blur: true },
    m: { bg: 'bg-3-m', pes: 'pes-3-m', h: 512.635 },
    dim: 0.2,
  },
  {
    d: { bg: 'bg-4', pes: 'pes-4', left: 335.78, top: 59.45, w: 584.5, h: 581, blur: true },
    m: { bg: 'bg-4-m', pes: 'pes-4-m', h: 512.635 },
    dim: 0,
  },
  {
    d: { bg: 'bg-5', pes: 'pes-5', left: 429.03, top: 50.7, w: 584.261, h: 809.493, blur: true },
    m: { bg: 'bg-5-m', pes: 'pes-5-m', h: 512.635 },
    dim: 0,
  },
];

/**
 * GIF 1x1 transparente. Um <img> sem `src` e com largura/altura definidas
 * desenha a caixa de imagem quebrada do navegador — aparecia uma borda cinza
 * quadrada em volta da pessoa antes de carregar.
 */
const PIXEL_VAZIO =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

/** no mobile a pessoa é sempre 370 de largura, centrada, em top 253.68 */
const M_PES = { w: 370, top: 253.68 };
---

<section aria-label="Programa de Estágio Unilever 2027">
  <!-- O título do hero é imagem (lockup + "bora elevar"), então o h1 real da
       página vive aqui, visível só para leitores de tela e buscadores. -->
  <h1 class="sr-only">
    Programa de Estágio Unilever 2027 — Bora elevar o game? Inscrições abertas.
  </h1>
  <!-- ══════════════════ MOBILE (< 768px) ══════════════════ -->
  <div class="hero-viewport-m md:hidden">
    <div class="hero-stage-m" data-hero-stage>
      {
        SLIDES.map((slide, i) => (
          <div class="absolute inset-0 overflow-hidden" data-hero-slide aria-hidden="true">
            <div data-hero-bg class="absolute inset-0" style={`opacity:${i === 0 ? 1 : 0}`}>
              <img
                {...(i === 0 ? { src: `${import.meta.env.BASE_URL}images/hero/${slide.m.bg}.webp` } : { "data-src": `${import.meta.env.BASE_URL}images/hero/${slide.m.bg}.webp` })}
                alt=""
                class="absolute inset-0 size-full object-cover"
                loading="lazy"
                />
              {slide.dim > 0 && <div class="absolute inset-0" style={`background:rgb(0 0 0 / ${slide.dim})`} />}
            </div>
          </div>
        ))
      }

      <!-- Vinheta e moldura: no mobile os mesmos assets aparecem girados -90°.
           O Figma exporta isso com container queries (100cqw/100cqh), mas as
           unidades não resolvem certo aqui — a moldura saía 100px curta. Como o
           palco tem tamanho conhecido (390x672em), as caixas vão em `em`:
           o filho recebe largura/altura trocadas, é centrado e então girado. -->
      <div class="pointer-events-none absolute left-0 top-0 h-[639.9em] w-[390em]">
        <img
          src={`${import.meta.env.BASE_URL}images/hero/vinheta.webp`}
          alt=""
          class="absolute left-1/2 top-1/2 h-[390em] w-[639.9em] -translate-x-1/2 -translate-y-1/2 -rotate-90"
          loading="lazy"
        />
      </div>
      <div class="pointer-events-none absolute left-[13.61em] top-[12.5em] h-[614.9em] w-[362.78em]">
        <HeroFrame
          class="absolute left-1/2 top-1/2 h-[362.78em] w-[614.9em] -translate-x-1/2 -translate-y-1/2 -rotate-90 text-aqua"
        />
      </div>

      <!-- conteúdo fixo -->
      <div class="absolute left-1/2 top-0 h-[319em] w-[303em] -translate-x-1/2 overflow-hidden">
        <HeroShape
          class="absolute left-1/2 top-[-3.14em] h-[301.22em] w-[286.006em] -translate-x-1/2 text-sky"
        />
        <img
          data-hero-in="0"
          src={`${import.meta.env.BASE_URL}images/hero/lockup.webp`}
          alt="Programa de Estágio Unilever 2027"
          class="absolute left-1/2 top-[43.04em] h-[99.245em] w-[172.479em] -translate-x-1/2"
          loading="lazy"
          fetchpriority="high"
        />
        <img
          data-hero-in="1"
          src={`${import.meta.env.BASE_URL}images/hero/bora.webp`}
          alt="Bora elevar o game?"
          class="absolute top-[177.1em] h-[47.077em] w-[152.146em] -translate-x-1/2"
          style="left:calc(50% - 10.17em)"
          loading="lazy"
          fetchpriority="high"
        />
      </div>

      <!-- Pessoas — acima do conteúdo, como no Figma (o sujeito principal cobre
           o shape e o lockup). No mobile ainda ficam ABAIXO do CTA e do badge. -->
      {
        SLIDES.map((slide, i) => (
          <img
            data-hero-pes
            src={i === 0 ? `${import.meta.env.BASE_URL}images/hero/${slide.m.pes}.webp` : PIXEL_VAZIO}
            {...(i === 0 ? {} : { 'data-src': `${import.meta.env.BASE_URL}images/hero/${slide.m.pes}.webp` })}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute left-1/2 max-w-none -translate-x-1/2"
            style={`top:${M_PES.top}em;width:${M_PES.w}em;height:${slide.m.h}em;opacity:${i === 0 ? 1 : 0}`}
            loading="lazy"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))
      }

      <p
        data-hero-badge
        class="card absolute left-[43.5em] top-[448.5em] rounded-[10.933em] px-[17.492em] py-[8.746em] text-sky"
      >
        <span class="block text-[16em] leading-[1]">
          Inscrições<br /><strong class="font-bold">abertas!</strong>
        </span>
      </p>

      <!-- A cascata de entrada anima `y`, e o Motion deixa um transform INLINE no
           elemento — que vence o `.btn:hover`. Por isso o data-hero-in mora no
           invólucro: o transform do hover fica só do botão. -->
      <div data-hero-in="1" class="absolute left-0 right-0 top-[526em] flex justify-center">
        <a
          href={inscricaoUrl('hero')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-invert rounded-[16em] px-[24em] pb-[14em] pt-[16em]"
        >
          <span class="text-[20em] leading-[1]">Inscreva-se agora!</span>
        </a>
      </div>

      <!-- Navegação do carrossel. Não existe no Figma: adicionada para dar
           controle manual ao usuário, alinhada ao CTA no desktop e abaixo dele
           no mobile. -->
      <!-- top compensado: a caixa de toque tem 24px e a pílula 8em, então o
           topo sobe (12px - 4em) para a bolinha continuar no mesmo y de antes. -->
      <ul
        class="absolute left-1/2 top-[calc(600em-12px)] flex -translate-x-1/2 items-center"
        aria-label="Escolher slide"
      >
        {
          SLIDES.map((_, i) => (
            <li>
              <button
                type="button"
                data-hero-dot={i}
                aria-label={`Slide ${i + 1} de ${SLIDES.length}`}
                aria-current={i === 0 ? 'true' : 'false'}
                class="bolinha"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Faixa de marcas do mobile. Figma 4204:19230: 342×68.081 em x=24, ou seja
       24px de respiro de cada lado — não é largura cheia. O centro do pill fica
       sobre a borda inferior do hero, daí o -mt de metade da altura. O asset é o
       mesmo do desktop (mesma proporção), exportado a 4x. -->
  <div class="relative z-20 -mt-[34.04px] md:hidden">
    <img
      src={`${import.meta.env.BASE_URL}images/hero/marca.webp`}
      alt="Dove, OMO, Hellmann's e Rexona"
      width="1368"
      height="273"
      class="mx-6 block h-auto w-[calc(100%-48px)]"
      loading="lazy"
    />
  </div>

  <!-- ══════════════════ DESKTOP (>= 768px) ══════════════════ -->
  <div class="hidden px-6 md:block">
    <div class="hero-viewport">
      <div class="hero-stage" data-hero-stage>
        {
          SLIDES.map((slide, i) => (
            <div class="absolute inset-0 overflow-hidden" data-hero-slide aria-hidden="true">
              <div data-hero-bg class="absolute inset-0" style={`opacity:${i === 0 ? 1 : 0}`}>
                <img
                  {...(i === 0 ? { src: `${import.meta.env.BASE_URL}images/hero/${slide.d.bg}.webp` } : { "data-src": `${import.meta.env.BASE_URL}images/hero/${slide.d.bg}.webp` })}
                  alt=""
                  class:list={['absolute inset-0 size-full object-cover', slide.d.blur && 'scale-[1.03] blur-[2px]']}
                  loading="lazy"
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                {slide.dim > 0 && <div class="absolute inset-0" style={`background:rgb(0 0 0 / ${slide.dim})`} />}
              </div>
            </div>
          ))
        }

        <img
          src={`${import.meta.env.BASE_URL}images/hero/vinheta.webp`}
          alt=""
          class="pointer-events-none absolute inset-0 size-full object-cover"
          loading="lazy"
        />
        <div class="pointer-events-none absolute inset-0 bg-black/10"></div>

        <HeroFrame
          class="pointer-events-none absolute bottom-[3.49%] left-[1.95%] right-[1.96%] top-[3.64%] text-aqua"
        />

        <div class="absolute left-1/2 top-0 flex w-[1216em] -translate-x-1/2 items-center justify-between px-[12em]">
          <div class="relative h-[538em] w-[512em] shrink-0 overflow-hidden">
            <HeroShape class="absolute left-[0.19%] right-[4.73%] top-0 h-[512.712em] text-sky" />

            <img
              data-hero-in="0"
              src={`${import.meta.env.BASE_URL}images/hero/lockup.webp`}
              alt="Programa de Estágio Unilever 2027"
              class="absolute left-[78.38em] top-[77.97em] h-[191.034em] w-[332em]"
              loading="lazy"
              fetchpriority="high"
            />

            <div data-hero-in="1" class="absolute left-[78.38em] top-[330.72em]">
              <a
                href={inscricaoUrl('hero')}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-invert rounded-[16em] px-[32em] pb-[22em] pt-[24em]"
              >
                <span class="text-[24em] leading-[0.8333]">Inscreva-se agora!</span>
              </a>
            </div>

          </div>

          <div class="relative h-[316em] w-[372em] shrink-0">
            <img
              data-hero-in="1"
              src={`${import.meta.env.BASE_URL}images/hero/bora.webp`}
              alt="Bora elevar o game?"
              class="absolute left-[0.39em] top-[0.17em] w-[372em]"
              style="aspect-ratio:1115/345"
              loading="lazy"
              fetchpriority="high"
            />

            <p data-hero-badge class="card absolute left-[154em] top-[189.15em] rounded-[20em] px-[32em] py-[16em] text-sky">
              <!-- leading 1: no Figma as duas linhas de 32px somam 64px exatos -->
              <span class="block text-[32em] leading-[1]">
                Inscrições<br /><strong class="font-bold">abertas!</strong>
              </span>
            </p>
          </div>
        </div>

        <!-- Pessoas — acima do conteúdo, abaixo da faixa de marcas (ordem do Figma) -->
        {
          SLIDES.map((slide, i) => (
            <img
              data-hero-pes
              src={i === 0 ? `${import.meta.env.BASE_URL}images/hero/${slide.d.pes}.webp` : PIXEL_VAZIO}
              {...(i === 0 ? {} : { 'data-src': `${import.meta.env.BASE_URL}images/hero/${slide.d.pes}.webp` })}
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute max-w-none"
              style={`left:${slide.d.left}em;top:${slide.d.top}em;width:${slide.d.w}em;height:${slide.d.h}em;opacity:${i === 0 ? 1 : 0}`}
              loading="lazy"
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          ))
        }

      <!-- Navegação do carrossel. Vive no nível do PALCO, não dentro do
             content-side: aquele bloco tem overflow-hidden e 538em de altura,
             então os bullets em 574em ficavam cortados (invisíveis).
             O left 178.38 = 100 (borda do content-side) + 78.38 (mesmo x do CTA). -->
        <!-- Não existe no Figma: adicionada para dar
           -->
      <!-- top e left compensados: a caixa de toque tem 24px e a pílula 8em, então
           o bloco recua (12px - 4em) nos dois eixos para a primeira bolinha
           continuar no mesmo x do CTA e no mesmo y de antes. -->
      <ul
        class="absolute left-[calc(182.38em-12px)] top-[calc(578em-12px)] flex items-center"
        aria-label="Escolher slide"
      >
        {
          SLIDES.map((_, i) => (
            <li>
              <button
                type="button"
                data-hero-dot={i}
                aria-label={`Slide ${i + 1} de ${SLIDES.length}`}
                aria-current={i === 0 ? 'true' : 'false'}
                class="bolinha"
              />
            </li>
          ))
        }
      </ul>

        <img
          data-hero-in="2"
          src={`${import.meta.env.BASE_URL}images/hero/marca.webp`}
          alt="Dove, OMO, Hellmann's e Rexona"
          class="absolute top-[512.71em] h-auto w-[342em] -translate-x-1/2"
          style="left:calc(50% + 424.65em)"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* --- desktop: 1392x640, trava em 1:1 a partir de 1440px de viewport --- */
  /* Trava em 1392 e CENTRA. Sem o margin-inline o palco encostava na
     esquerda em telas ultrawide, com todo o vazio sobrando à direita. */
  .hero-viewport {
    position: relative;
    width: min(100%, 1392px);
    margin-inline: auto;
    height: calc(640 * min(1px, (100vw - 48px) / 1392));
    border-radius: calc(32 * min(1px, (100vw - 48px) / 1392));
    overflow: hidden;
  }

  /* Enquanto o gesto de swipe está em curso o palco não seleciona texto —
     arrastar sobre a chamada saía pintando a seleção do navegador. O atributo
     entra no pointerdown e sai no pointerup, então fora do arraste o texto
     segue selecionável normalmente. */
  [data-hero-stage][data-arrastando] {
    user-select: none;
    -webkit-user-select: none;
  }

  .hero-stage {
    font-size: min(1px, calc((100vw - 48px) / 1392));
    position: absolute;
    inset: 0;
    width: 1392em;
    height: 640em;
  }

  /* bolinhas do carrossel: pílula que estica quando ativa */
  /* WCAG 2.2 (2.5.8): o BOTÃO é o alvo de toque — 24x24 em px de verdade, não
     em `em`, porque o em do palco encolhe junto com a viewport e 24em viraria
     ~22px num celular de 360. A pílula desenhada continua 8em: quem cresceu foi
     a área invisível ao redor dela, no ::before.
     Sem gap na lista de propósito: com caixas de 24px encostadas, o centro de
     uma pílula fica a 24px do centro da vizinha, que é exatamente o mínimo. Pôr
     gap aqui só afasta mais as bolinhas do desenho original. */
  .bolinha {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    cursor: pointer;
  }
  .bolinha::before {
    content: '';
    display: block;
    width: 8em;
    height: 8em;
    border-radius: 999em;
    background: rgb(255 255 255 / 0.45);
    transition: width 300ms ease, background 300ms ease;
  }
  .bolinha:hover::before {
    background: rgb(255 255 255 / 0.75);
  }
  .bolinha[aria-current='true']::before {
    width: 26em;
    background: var(--color-cloud);
  }

  /* --- mobile: 390x672, full-bleed, escala livre com a viewport --- */
  .hero-viewport-m {
    position: relative;
    height: calc(672 * (100vw / 390));
    overflow: hidden;
  }

  .hero-stage-m {
    font-size: calc(100vw / 390);
    position: absolute;
    inset: 0;
    width: 390em;
    height: 672em;
  }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion';

  /**
   * Animações do hero — valores copiados 1:1 do Hero.jsx da versão React.
   * Como `motion` é o mesmo Framer Motion, só muda a sintaxe (imperativa em
   * vez de declarativa); durações, easings e a mola são idênticos.
   *
   *   fundo    opacity 0→1, scale 1.05→1   1s    easeOut   (Ken Burns)
   *   pessoa   opacity 0→1, y 60→0         0.7s  easeOut   (sai em y -24)
   *   cascata  opacity 0→1, y 32→0         0.6s  delay 0.15·i
   *   badge    opacity 0→1, scale 0.8→1    mola stiffness 300 damping 20
   *
   * ÚNICO desvio: no primeiro paint o fundo NÃO entra de opacity 0 — ele é o
   * candidato a LCP e um fade de 1s atrasaria a métrica. O scale roda mesmo
   * assim (não impede a pintura), então o Ken Burns inicial se mantém. Nas
   * trocas seguintes o crossfade é completo, como no original.
   */
  const INTERVALO = 6000;
  const EASE_OUT = [0, 0, 0.58, 1];

  /** troca data-src por src depois do primeiro paint — tira ~300KB do caminho crítico */
  const carregarDemais = () => {
    for (const img of document.querySelectorAll<HTMLImageElement>('[data-hero-stage] img[data-src]')) {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    }
  };
  if (document.readyState === 'complete') carregarDemais();
  else window.addEventListener('load', carregarDemais, { once: true });

  const palcos = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-stage]'));
  const slidesPorPalco = palcos.map((p) => Array.from(p.querySelectorAll<HTMLElement>('[data-hero-slide]')));
  const total = slidesPorPalco[0]?.length ?? 0;

  // A pessoa não mora mais dentro do slide (é pintada acima do conteúdo, como
  // no Figma), então fundo e pessoa são casados por índice.
  const pessoasPorPalco = palcos.map((p) => Array.from(p.querySelectorAll<HTMLElement>('[data-hero-pes]')));

  const camadas = (palco: number, i: number) => ({
    bg: slidesPorPalco[palco][i].querySelector<HTMLElement>('[data-hero-bg]')!,
    pes: pessoasPorPalco[palco][i],
  });

  if (total > 0 && !prefersReducedMotion()) {
    const { animate } = await import('motion');

    // ── entrada: Ken Burns do primeiro fundo + cascata do primeiro plano ──
    slidesPorPalco.forEach((_, palco) => {
      animate(camadas(palco, 0).bg, { scale: [1.05, 1] }, { duration: 1, ease: EASE_OUT });
    });

    const entrando = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-in]'));
    for (const el of entrando) {
      const ordem = Number(el.dataset.heroIn ?? 0);
      animate(el, { opacity: [0, 1], y: [32, 0] }, { duration: 0.6, delay: 0.15 * ordem, ease: EASE_OUT });
    }

    for (const badge of document.querySelectorAll<HTMLElement>('[data-hero-badge]')) {
      animate(
        badge,
        { opacity: [0, 1], scale: [0.8, 1] },
        { delay: 0.5, type: 'spring', stiffness: 300, damping: 20 }
      );
    }

    // ── troca de slides ────────────────────────────────────────────────
    let atual = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const irPara = (proximo: number) => {
      if (proximo === atual) return;
      for (const dot of document.querySelectorAll<HTMLElement>('[data-hero-dot]')) {
        dot.setAttribute('aria-current', String(Number(dot.dataset.heroDot) === proximo));
      }

      slidesPorPalco.forEach((_, palco) => {
        const sai = camadas(palco, atual);
        const entra = camadas(palco, proximo);

        animate(sai.bg, { opacity: 0 }, { duration: 1, ease: EASE_OUT });
        animate(sai.pes, { opacity: 0, y: -24 }, { duration: 0.7, ease: EASE_OUT });

        animate(entra.bg, { opacity: [0, 1], scale: [1.05, 1] }, { duration: 1, ease: EASE_OUT });
        animate(entra.pes, { opacity: [0, 1], y: [60, 0] }, { duration: 0.7, ease: EASE_OUT });
      });
      atual = proximo;
    };

    const parar = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const iniciar = () => {
      parar();
      if (total > 1) timer = setInterval(() => irPara((atual + 1) % total), INTERVALO);
    };

    /**
     * O autoplay só começa quando as imagens dos OUTROS slides já chegaram.
     * Elas só começam a baixar no `load` (data-src), e numa rede estrangulada
     * isso é tarde: trocar de slide antes disso mostra um <img> sem bytes e o
     * fundo do slide 2 virava o LCP da página (18,6s no perfil móvel do
     * Lighthouse, com 12s só de espera pelo download). Esperar os bytes é o
     * comportamento correto de qualquer jeito — ninguém quer ver o slide vazio.
     * O teto de 8s garante que o carrossel ande mesmo se algo falhar.
     */
    const imagensProntas = () => {
      const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('[data-hero-stage] img'));
      return Promise.race([
        Promise.all(
          imgs.map(
            (im) =>
              im.complete ||
              new Promise((ok) => {
                im.addEventListener('load', ok, { once: true });
                im.addEventListener('error', ok, { once: true });
              })
          )
        ),
        new Promise((ok) => setTimeout(ok, 8000)),
      ]);
    };

    const comecarAutoplay = () => void imagensProntas().then(iniciar);
    if (document.readyState === 'complete') comecarAutoplay();
    else window.addEventListener('load', comecarAutoplay, { once: true });

    for (const dot of document.querySelectorAll<HTMLElement>('[data-hero-dot]')) {
      dot.addEventListener('click', () => {
        irPara(Number(dot.dataset.heroDot));
        iniciar(); // reinicia o cronômetro após escolha manual
      });
    }

    for (const palco of palcos) {
      // Sem pausa no mouse: o que muda entre slides é só a imagem — o texto e o
      // CTA são os mesmos —, então parar ao passar o mouse não protege leitura
      // nenhuma e só deixa o carrossel travado em quem usa mouse.
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? parar() : iniciar()));

    // ── swipe / arraste ────────────────────────────────────────────────
    // Vale no touch e no desktop. `touch-action: pan-y` deixa a rolagem
    // vertical passar: só o gesto horizontal troca de slide.
    const LIMIAR = 60;

    for (const palco of palcos) {
      let inicioX = 0;
      let inicioY = 0;
      let ativo = false;

      palco.style.touchAction = 'pan-y';
      // afordância de arraste: mãozinha aberta em repouso, fechada durante o gesto.
      // Botões e links dentro do palco mantêm o `pointer` da folha do navegador.
      palco.style.cursor = 'grab';

      palco.addEventListener(
        'pointerdown',
        (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          ativo = true;
          inicioX = e.clientX;
          inicioY = e.clientY;
          palco.style.cursor = 'grabbing';
          palco.setAttribute('data-arrastando', '');
        },
        { passive: true }
      );

      palco.addEventListener('pointerup', (e) => {
        palco.style.cursor = 'grab';
        palco.removeAttribute('data-arrastando');
        if (!ativo) return;
        ativo = false;
        const dx = e.clientX - inicioX;
        const dy = e.clientY - inicioY;
        // ignora se o gesto foi mais vertical que horizontal (é rolagem)
        if (Math.abs(dx) < LIMIAR || Math.abs(dx) < Math.abs(dy)) return;
        irPara((atual + (dx < 0 ? 1 : total - 1)) % total);
        iniciar();
      });

      palco.addEventListener('pointercancel', () => {
        ativo = false;
        palco.style.cursor = 'grab';
        palco.removeAttribute('data-arrastando');
      });
    }
  }
</script>
