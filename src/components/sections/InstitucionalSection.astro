---
import { INSTITUCIONAL } from '../../data/institucional';

/**
 * Carrossel institucional — seção azul com baralho de cards.
 *
 * Figma: 4188:12078 (desktop, 880px incluindo o divisor de 56px)
 *        4204:18917 (mobile, 873px)
 *
 * Geometria do baralho, medida no Figma (largura · topo · altura):
 *   desktop  frente 1192·0·520 · meio 1149·27.12·502 · fundo 1081·51.68·484.64
 *   mobile   frente  342·0·657 · meio  325·41.68·624 · fundo  309·78.78·592.9
 *
 * O BARALHO É FEITO DOS PRÓPRIOS SLIDES, não de cascas decorativas. Cada card
 * recebe uma posição em função da distância até o slide atual:
 *
 *   já visto → saiu (sobe e desaparece)   ·   0 → frente
 *   1 → meio   ·   2 → fundo   ·   3+ → escondido (no fundo, invisível)
 *
 * Isso dá três coisas de uma vez: (a) o stack encurta sozinho — no último slide
 * não há nada atrás, porque não há mais slide para ficar atrás; (b) avançar tira
 * o card por cima, de baixo para cima, e voltar traz o mesmo card de volta de
 * cima para baixo, sem código de direção; (c) a virada é só `transform` e
 * `opacity` com transição de CSS — nenhuma troca de conteúdo, nenhum reflow,
 * nenhuma decodificação de imagem no meio do movimento. Era daí que vinha o
 * tranco: antes havia um card só e a virada reescrevia texto e `src`.
 */
---

<!-- divisor de entrada: recorte em zigue-zague para o azul -->
<img
  src={`${import.meta.env.BASE_URL}images/dividers/wave-start.svg`}
  alt=""
  aria-hidden="true"
  class="block h-[15.17px] w-full lg:h-14"
/>

<section id="a-unilever" class="overflow-hidden bg-sky" aria-roledescription="carrossel" aria-label="A Unilever">
  <div class="container-lp flex flex-col gap-8 px-6 pb-[72px] pt-[72px] lg:gap-16 lg:px-3 lg:pb-20 lg:pt-[120px]">
    <!-- ── baralho ──────────────────────────────────────────────────── -->
    <!-- altura = card da frente; o fundo assoma para além dela, dentro do
         padding da seção, exatamente como as cascas faziam antes -->
    <div data-inst-baralho class="relative h-[657px] lg:h-[520px]">
      {
        INSTITUCIONAL.map((slide, i) => (
          <article
            data-inst-card={i}
            data-pos={i === 0 ? 'frente' : i === 1 ? 'meio' : i === 2 ? 'fundo' : 'escondido'}
            class="carta-slide absolute left-0 top-0 flex h-[657px] w-full flex-col overflow-hidden rounded-[28px] lg:h-[520px] lg:flex-row"
            inert={i === 0 ? undefined : true}
          >
            {/* imagem: em cima no mobile, à direita no desktop */}
            <div class="h-[296px] shrink-0 overflow-hidden lg:order-2 lg:h-full lg:w-1/2">
              <img
                src={slide.foto}
                alt={slide.alt}
                width="1110"
                height="1036"
                loading="lazy"
                draggable="false"
                class="size-full object-cover"
              />
            </div>

            <div
              class="flex flex-1 flex-col justify-center gap-4 px-7 py-8 lg:order-1 lg:w-1/2 lg:gap-5 lg:px-14 lg:py-13"
            >
              <h3 class="text-[24px] font-bold leading-[1.2] text-sky lg:text-[32px] lg:leading-[1.4]">
                {slide.titulo}
              </h3>
              <p class="body max-w-[449px] lg:text-[18px]" set:html={slide.corpo} />
            </div>
          </article>
        ))
      }
    </div>

    <!-- ── controles ────────────────────────────────────────────────── -->
    <div class="flex h-10 items-center justify-center gap-4 lg:justify-start">
      <button type="button" data-inst-prev class="seta" aria-label="Slide anterior">
        <img src={`${import.meta.env.BASE_URL}images/icons/arrow-prev.svg`} alt="" width="10" height="18" class="h-[18px] w-[10px]" />
      </button>

      <p class="flex items-center gap-2 text-[18px] text-cloud" aria-live="polite">
        <span data-inst-atual>1</span><span aria-hidden="true">/</span><span>{INSTITUCIONAL.length}</span>
      </p>

      <button type="button" data-inst-next class="seta" aria-label="Próximo slide">
        <img src={`${import.meta.env.BASE_URL}images/icons/arrow-next.svg`} alt="" width="10" height="18" class="h-[18px] w-[10px]" />
      </button>
    </div>
  </div>
</section>

<style>
  /* ── o baralho ───────────────────────────────────────────────────────
     As posições são escala + deslocamento vertical com origem no TOPO, então o
     que importa é onde a borda de baixo cai — é a única parte de meio e fundo
     que aparece. Os valores saem do Figma:

       mobile   meio  325/342 = 0.95    base em 665.83 → y 41.68
                fundo 309/342 = 0.9025  base em 671.68 → y 78.78
       desktop  meio 1149/1192 = 0.9639 base em 529.12 → y 27.90
                fundo 1081/1192 = 0.9070 base em 536.32 → y 64.70   */
  .carta-slide {
    --s-meio: 0.95;
    --y-meio: 41.68px;
    --s-fundo: 0.9025;
    --y-fundo: 78.78px;

    transform-origin: top center;
    background: var(--color-cloud);
    border: 1px solid #e8eaf1;
    box-shadow: 0 24px 54px -30px rgb(19 32 51 / 0.35);
    will-change: transform, opacity;
    /* `linear()` é a mola do UnileverCarousel.jsx (spring 260 / 30 / mass 0.9)
       amostrada: 373ms, praticamente sem overshoot. Como é transição de CSS, a
       animação roda no compositor — não há trabalho de JS por quadro. */
    transition:
      transform 373ms
        linear(0, 0.0409, 0.134, 0.2483, 0.3654, 0.4754, 0.5733, 0.6576, 0.7283, 0.7864, 0.8335, 0.8711, 0.9009, 0.9242, 0.9424, 0.9564, 0.9672, 0.9754, 0.9816, 0.9863, 1),
      opacity 300ms ease;
  }

  @media (min-width: 1024px) {
    .carta-slide {
      --s-meio: 0.9639;
      --y-meio: 27.9px;
      --s-fundo: 0.907;
      --y-fundo: 64.7px;
    }
  }

  /* o que já passou sai por cima, subindo */
  .carta-slide[data-pos='saiu'] {
    transform: translateY(-64px) scale(1);
    opacity: 0;
    z-index: 5;
  }

  .carta-slide[data-pos='frente'] {
    transform: translateY(0) scale(1);
    opacity: 1;
    z-index: 4;
  }

  .carta-slide[data-pos='meio'] {
    transform: translateY(var(--y-meio)) scale(var(--s-meio));
    opacity: 1;
    z-index: 3;
  }

  .carta-slide[data-pos='fundo'] {
    transform: translateY(var(--y-fundo)) scale(var(--s-fundo));
    opacity: 1;
    z-index: 2;
  }

  /* do quarto em diante: já no lugar do fundo, só invisível — assim entrar no
     stack é só acender, sem salto de posição */
  .carta-slide[data-pos='escondido'] {
    transform: translateY(var(--y-fundo)) scale(var(--s-fundo));
    opacity: 0;
    z-index: 1;
  }

  /* durante o arraste o transform é inline; a transição sairia na frente */
  .carta-slide[data-arrastando] {
    transition: none;
  }

  .carta-slide[inert] {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carta-slide {
      transition: opacity 1ms linear;
    }
  }

  .seta {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: var(--color-cloud);
    transition: opacity 200ms ease, transform 150ms ease;
  }
  /* hover:-translate-y-0.5 do UnileverCarousel.jsx */
  .seta:hover {
    transform: translateY(-2px);
  }
  /* whileTap do legado */
  .seta:active {
    transform: scale(0.9);
  }
  /* no Figma a seta inativa fica em 20% */
  .seta[data-inativa] {
    opacity: 0.2;
    cursor: default;
  }
  /* a inativa não se move, mas clareia (hover:opacity-100 do legado) */
  .seta[data-inativa]:hover {
    transform: none;
    opacity: 0.35;
  }
</style>

<script>
  import { INSTITUCIONAL } from '../../data/institucional';

  /** px de arraste para trocar de slide, e a resistência nas pontas (dragElastic) */
  const LIMIAR = 60;
  const ELASTICO = 0.22;

  const baralho = document.querySelector<HTMLElement>('[data-inst-baralho]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-inst-card]'));

  if (baralho && cards.length) {
    const contador = document.querySelector<HTMLElement>('[data-inst-atual]')!;
    const prev = document.querySelector<HTMLButtonElement>('[data-inst-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-inst-next]')!;

    let atual = 0;

    /** Uma função só: a posição de cada card é a distância até o atual. */
    const posicionar = () => {
      cards.forEach((card, i) => {
        const d = i - atual;
        card.dataset.pos = d < 0 ? 'saiu' : d === 0 ? 'frente' : d === 1 ? 'meio' : d === 2 ? 'fundo' : 'escondido';
        card.toggleAttribute('inert', d !== 0);
      });

      contador.textContent = String(atual + 1);
      for (const [btn, inativo] of [
        [prev, atual === 0],
        [next, atual === INSTITUCIONAL.length - 1],
      ] as const) {
        btn.toggleAttribute('data-inativa', inativo);
        btn.disabled = inativo;
      }
    };

    const ir = (passo: number) => {
      const alvo = atual + passo;
      if (alvo < 0 || alvo >= cards.length) return;
      atual = alvo;
      posicionar();
    };

    posicionar();
    prev.addEventListener('click', () => ir(-1));
    next.addEventListener('click', () => ir(1));

    // ── arraste / swipe ────────────────────────────────────────────────
    // Os móveis ficam na janela em vez de setPointerCapture: com a captura, o
    // `click` passa a ser entregue ao elemento capturador e os controles param
    // de responder (foi o que quebrou os stories).
    let inicioX = 0;
    let arrastando = false;

    baralho.style.touchAction = 'pan-y';

    baralho.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      arrastando = true;
      inicioX = e.clientX;
      cards[atual].setAttribute('data-arrastando', '');
    });

    window.addEventListener('pointermove', (e) => {
      if (!arrastando) return;
      const dx = e.clientX - inicioX;
      const noLimite = (dx > 0 && atual === 0) || (dx < 0 && atual === cards.length - 1);
      // o card da frente está em translateY(0) scale(1): só somamos o eixo X
      cards[atual].style.transform = `translateX(${noLimite ? dx * ELASTICO : dx}px)`;
    });

    const soltar = (e: PointerEvent) => {
      if (!arrastando) return;
      arrastando = false;
      const dx = e.clientX - inicioX;
      const card = cards[atual];
      card.removeAttribute('data-arrastando');
      card.style.transform = ''; // volta ao transform da posição, com transição
      if (Math.abs(dx) > LIMIAR) ir(dx < 0 ? 1 : -1);
    };

    window.addEventListener('pointerup', soltar);
    window.addEventListener('pointercancel', soltar);
  }
</script>
