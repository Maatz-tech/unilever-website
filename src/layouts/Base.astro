---
import '../styles/global.css';
import { localidades as LOCALIDADES } from '../data/localidades.js';
import { BENEFICIOS } from '../data/beneficios';

interface Props {
  title: string;
  description?: string;
  /** Caminho da imagem OG (1200×630). Relativo a /public. */
  ogImage?: string;
}

const {
  title,
  description = 'Programa de Estágio Unilever 2027. Inscrições abertas — bora elevar o game?',
  ogImage = '/og.jpg',
} = Astro.props;

// `site` vem do astro.config.mjs — TODO: trocar pelo domínio final
const SITE_URL = Astro.site?.href ?? 'https://exemplo.com.br/';
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const FONTS = `${import.meta.env.BASE_URL}fonts/`;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

/**
 * Datas do processo, confirmadas pelo cliente: inscrições de 03/08 a 03/09 de
 * 2026 e início na empresa em fevereiro de 2027 — daí o nome do programa. Têm
 * de bater com a seção "As fases do game".
 */
const INSCRICOES_ABREM = '2026-08-03';
const INSCRICOES_FECHAM = '2026-09-03T23:59:59-03:00';
const INICIO_NA_EMPRESA = '2027-02-01';

/** Structured data: a página é uma vaga de estágio + a organização */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}#organizacao`,
      name: 'Unilever',
      url: SITE_URL,
      logo: new URL(`${import.meta.env.BASE_URL}images/brand/unilever.webp`, SITE_URL).href,
    },
    {
      /**
       * A vaga em si. É o que faz um buscador (Google Jobs) e um agente
       * entenderem o programa: prazo, formato, localidades e requisitos.
       * Só passa a valer quando o `noindex` sair, no lançamento.
       */
      '@type': 'JobPosting',
      '@id': `${SITE_URL}#vaga`,
      title: 'Estágio — Programa de Estágio Unilever 2027',
      description:
        '<p>Programa de Estágio Unilever 2027. Atuação em projetos reais, com mentoria de lideranças, contato com um negócio global e trilha de desenvolvimento.</p>' +
        '<h3>Pré-requisitos</h3><ul>' +
        '<li>Cursando Instituição de Ensino Superior (bacharelado, licenciatura ou tecnólogo), com previsão de conclusão entre 12/2027 e 12/2028.</li>' +
        '<li>Disponibilidade para estagiar em formato híbrido e presencial.</li>' +
        '<li>Disponibilidade para 30 horas semanais (6h diárias), sem compensação de horas.</li>' +
        '</ul>',
      datePosted: INSCRICOES_ABREM,
      validThrough: INSCRICOES_FECHAM,
      jobStartDate: INICIO_NA_EMPRESA,
      employmentType: 'INTERN',
      educationRequirements: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Ensino superior em andamento',
      },
      workHours: '30 horas semanais, 6h diárias',
      hiringOrganization: { '@id': `${SITE_URL}#organizacao` },
      jobLocationType: undefined,
      jobLocation: LOCALIDADES.flatMap((uf) =>
        uf.cidades.map((cidade) => ({
          '@type': 'Place',
          address: {
            '@type': 'PostalAddress',
            addressLocality: cidade,
            addressRegion: uf.nome,
            addressCountry: 'BR',
          },
        }))
      ),
      jobBenefits: BENEFICIOS.map((b) => b.texto.replace(/\*$/, '')).join(', '),
      directApply: false,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#site`,
      url: SITE_URL,
      name: 'Programa de Estágio Unilever 2027',
      inLanguage: 'pt-BR',
      publisher: { '@id': `${SITE_URL}#organizacao` },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- marca que o JS está ativo ANTES do primeiro paint: o CSS usa isso para
         esconder os blocos que vão ser revelados. Sem JS, nada é escondido. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Pré-lançamento: fora dos buscadores. Remover ao publicar (junto com o
         Disallow do robots.txt). -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- @font-face inline: o `url()` precisa do base do Pages, que CSS puro não
         consegue interpolar. is:inline mantém o CSS como escrito. -->
    <style is:inline set:html={`
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-light.woff2") format("woff2");
          font-weight: 300;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-regular.woff2") format("woff2");
          font-weight: 400;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-regular-italic.woff2") format("woff2");
          font-weight: 400;
          font-style: italic;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-semibold.woff2") format("woff2");
          font-weight: 600;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-semibold-italic.woff2") format("woff2");
          font-weight: 600;
          font-style: italic;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-bold.woff2") format("woff2");
          font-weight: 700;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-bold-italic.woff2") format("woff2");
          font-weight: 700;
          font-style: italic;
          font-display: swap;
        }
    `}></style>

    <!-- Ícones: o "U" da marca. .ico para navegadores antigos, PNG 32 para o
         resto, apple-touch para iOS (que ignora transparência, daí fundo branco). -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#0066cc" />

    <!-- LCP: pré-carrega só o fundo do hero do breakpoint atual -->
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}images/hero/bg-1.webp`} media="(min-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}images/hero/bg-1-m.webp`} media="(max-width: 767px)" fetchpriority="high" />

    <!-- Fonte da marca auto-hospedada: pré-carrega só os dois pesos usados
         acima do fold (regular e bold). Nada de request a CDN de terceiros. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/unilever-desire-regular.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/unilever-desire-bold.woff2`}
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <meta property="og:site_name" content="Programa de Estágio Unilever 2027" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Programa de Estágio Unilever 2027 — Bora elevar o game?" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-sky focus:px-4 focus:py-2 focus:text-cloud"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
