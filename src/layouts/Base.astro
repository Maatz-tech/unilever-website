---
import '../styles/global.css';
import { localidades as LOCALIDADES } from '../data/localidades.js';
import { BENEFICIOS } from '../data/beneficios';
import { REQUISITOS } from '../data/requisitos';
import { INSCRICOES_ABREM, INSCRICOES_FECHAM, INICIO_NA_EMPRESA } from '../data/site';
import WebMcp from '../components/WebMcp.astro';

interface Props {
  title: string;
  description?: string;
  /** Caminho da imagem OG (1200×630). Relativo a /public. */
  ogImage?: string;
}

const {
  title,
  description = 'Programa de Estágio Unilever 2027. Inscrições abertas — bora elevar o game?',
  ogImage = '/og.jpg',
} = Astro.props;

// `site` vem do astro.config.mjs
const SITE_URL = Astro.site?.href ?? 'https://estagiounilever.com.br/';
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const FONTS = `${import.meta.env.BASE_URL}fonts/`;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

/** Structured data: a página é uma vaga de estágio + a organização */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}#organizacao`,
      name: 'Unilever',
      url: SITE_URL,
      logo: new URL(`${import.meta.env.BASE_URL}images/brand/unilever.webp`, SITE_URL).href,
    },
    {
      /**
       * A vaga em si. É o que faz um buscador (Google Jobs) e um agente
       * entenderem o programa: prazo, formato, localidades e requisitos.
       */
      '@type': 'JobPosting',
      '@id': `${SITE_URL}#vaga`,
      title: 'Estágio — Programa de Estágio Unilever 2027',
      // A lista de pré-requisitos sai de src/data/requisitos.ts — a mesma que
      // a seção renderiza, então a vaga não descreve regra diferente da página.
      description:
        '<p>Programa de Estágio Unilever 2027. Atuação em projetos reais, com mentoria de lideranças, contato com um negócio global e trilha de desenvolvimento.</p>' +
        '<h3>Pré-requisitos</h3><ul>' +
        REQUISITOS.map((r) => `<li>${r.texto}</li>`).join('') +
        '</ul>',
      datePosted: INSCRICOES_ABREM,
      validThrough: INSCRICOES_FECHAM,
      jobStartDate: INICIO_NA_EMPRESA,
      employmentType: 'INTERN',
      educationRequirements: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Ensino superior em andamento',
      },
      workHours: '30 horas semanais, 6h diárias',
      hiringOrganization: { '@id': `${SITE_URL}#organizacao` },
      jobLocationType: undefined,
      jobLocation: LOCALIDADES.flatMap((uf) =>
        uf.cidades.map((cidade) => ({
          '@type': 'Place',
          address: {
            '@type': 'PostalAddress',
            addressLocality: cidade,
            addressRegion: uf.nome,
            addressCountry: 'BR',
          },
        }))
      ),
      jobBenefits: BENEFICIOS.map((b) => b.texto.replace(/\*$/, '')).join(', '),
      directApply: false,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#site`,
      url: SITE_URL,
      name: 'Programa de Estágio Unilever 2027',
      inLanguage: 'pt-BR',
      publisher: { '@id': `${SITE_URL}#organizacao` },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!-- WebMCP (origin trial do Chrome 149-156). A API só liga com um token
         emitido para o domínio; sem ele o componente WebMcp.astro não acha a
         API e não faz nada — não quebra.
         TODO: registrar https://estagiounilever.com.br no trial "WebMCP" em
         developer.chrome.com/origintrials e colar o token abaixo.
    <meta http-equiv="origin-trial" content="COLE_O_TOKEN_AQUI" /> -->
    <!-- Google Tag Manager — o mais alto possível no head, como o GTM pede.
         is:inline para o Astro não empacotar nem mover o snippet: ele precisa
         rodar na hora, é ele que cria o dataLayer que o resto usa. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-TLVV5RQ');
    </script>
    <!-- End Google Tag Manager -->
    <!-- marca que o JS está ativo ANTES do primeiro paint: o CSS usa isso para
         esconder os blocos que vão ser revelados. Sem JS, nada é escondido. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- @font-face inline: o `url()` precisa do base do Pages, que CSS puro não
         consegue interpolar. is:inline mantém o CSS como escrito. -->
    <style is:inline set:html={`
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-light.woff2") format("woff2");
          font-weight: 300;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-regular.woff2") format("woff2");
          font-weight: 400;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-regular-italic.woff2") format("woff2");
          font-weight: 400;
          font-style: italic;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-semibold.woff2") format("woff2");
          font-weight: 600;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-semibold-italic.woff2") format("woff2");
          font-weight: 600;
          font-style: italic;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-bold.woff2") format("woff2");
          font-weight: 700;
          font-style: normal;
          font-display: swap;
        }
        @font-face {
          font-family: "Unilever Desire";
          src: url("${FONTS}unilever-desire-bold-italic.woff2") format("woff2");
          font-weight: 700;
          font-style: italic;
          font-display: swap;
        }
    `}></style>

    <!-- Ícones: o "U" da marca. .ico para navegadores antigos, PNG 32 para o
         resto, apple-touch para iOS (que ignora transparência, daí fundo branco). -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta name="theme-color" content="#0066cc" />

    <!-- LCP: pré-carrega só o fundo do hero do breakpoint atual -->
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}images/hero/bg-1.webp`} media="(min-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href={`${import.meta.env.BASE_URL}images/hero/bg-1-m.webp`} media="(max-width: 767px)" fetchpriority="high" />

    <!-- Fonte da marca auto-hospedada: pré-carrega só os dois pesos usados
         acima do fold (regular e bold). Nada de request a CDN de terceiros. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/unilever-desire-regular.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${import.meta.env.BASE_URL}fonts/unilever-desire-bold.woff2`}
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <meta property="og:site_name" content="Programa de Estágio Unilever 2027" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Programa de Estágio Unilever 2027 — Bora elevar o game?" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <!-- Google Tag Manager (noscript) — logo depois do <body>, como o GTM pede.
         Fica antes do skip link, mas não atrapalha: o iframe é 0x0 e escondido,
         então não entra na ordem de foco nem é anunciado. -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TLVV5RQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-sky focus:px-4 focus:py-2 focus:text-cloud"
    >
      Ir para o conteúdo
    </a>
    <slot />

    <!-- ── VLibras ───────────────────────────────────────────────────────
         Tradutor de Libras do governo federal. A marcação é a que o plugin
         exige (atributos `vw`, `vw-access-button`, `vw-plugin-wrapper`) e ele
         a preenche sozinho com o ícone e o painel.

         O script PRECISA ser carregado antes do evento `load`: o plugin faz a
         renderização dentro de `window.onload`. Carregá-lo depois — por
         requestIdleCallback, por exemplo — deixa o botão existindo no DOM,
         com o tamanho e o cursor certos, mas VAZIO e invisível, porque o
         `onload` nunca mais dispara. Por isso `defer`, e não injeção tardia:
         não bloqueia o parse e ainda executa a tempo.

         São 17KB; o avatar 3D só baixa quando alguém abre o widget. É a única
         dependência externa do site.

         O botão fica fixo no canto. Os modais (stories e áreas) usam <dialog>
         nativo, que vive na top layer e sempre desenha por cima — não há
         disputa de z-index. -->
    <div vw class="enabled">
      <div vw-access-button class="active"></div>
      <div vw-plugin-wrapper>
        <div class="vw-plugin-top-wrapper"></div>
      </div>
    </div>

    <script is:inline defer src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script is:inline>
      // scripts `defer` rodam antes do DOMContentLoaded, então window.VLibras
      // já existe aqui — e o `window.onload` interno do plugin ainda está por vir
      window.addEventListener('DOMContentLoaded', function () {
        if (window.VLibras) new window.VLibras.Widget('https://vlibras.gov.br/app');
      });
    </script>

    <!-- Tools para agentes de IA. Fica no fim do body porque não tem nada a ver
         com o primeiro paint: é registro de API, não conteúdo. -->
    <WebMcp />
  </body>
</html>
